# Backend API Environment Configuration Template
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# Database (MySQL)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=infi_timepro_db
DB_USER=infi_timepro_user
DB_PASSWORD=your_secure_db_password_here

# Cache / Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Authentication
JWT_SECRET=change_me_to_a_long_random_secure_secret_string
JWT_EXPIRES_IN=15m
