    <Cell ss:StyleID="Cell"><Data ss:Type="String">Boundary</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">EMPLOYEE</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Insufficient Leave Balance Validation</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Employee has 2 Sick Leaves remaining</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">1. Apply for 5 Sick Leaves.</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">System blocks request with error &quot;Insufficient Sick Leave balance (Available: 2, Requested: 5)&quot;.</Data></Cell>
