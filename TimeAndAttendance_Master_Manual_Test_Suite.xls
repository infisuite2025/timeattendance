    <Cell ss:StyleID="Cell"><Data ss:Type="String">Unit/Functional</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">ADMIN</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">India Gross-to-Net Payroll Calculation (TDS + EPF + ESI + Gratuity)</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">On Interactive Calculator tab</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">1. Select Country &quot;India 🇮🇳&quot;. 2. Enter Gross Annual = ₹1,200,000. 3. Basic % = 40%. 4. Click &quot;Calculate&quot;.</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Accurately computes: Monthly Gross ₹100k, Basic ₹40k, Standard Deduction ₹75k, TDS income tax, EPF 12% capped at ₹1,800/mo, ESI 0%, net take-home, and employer cost.</Data></Cell>
