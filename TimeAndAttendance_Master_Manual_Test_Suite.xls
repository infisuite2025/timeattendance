    <Cell ss:StyleID="Cell"><Data ss:Type="String">Submit Leave Application</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Logged in as EMPLOYEE (Sarah) with 10 Casual Leaves available</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">1. Go to /leaves. 2. Click &quot;Apply Leave&quot;. 3. Select Casual Leave, dates Oct 10–12. 4. Submit.</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Leave request created in &quot;PENDING&quot; status, leave balance reserved.</Data></Cell>
