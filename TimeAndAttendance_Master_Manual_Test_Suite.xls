    <Cell ss:StyleID="Cell"><Data ss:Type="String">Add-on: Global Payroll</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Functional</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">ADMIN</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Browse 15 Country Profiles Across 7 Framework Clusters</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Global Payroll Engine active on /global-payroll</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">1. Go to /global-payroll/directory. 2. Filter by cluster &quot;GCC&quot;. 3. Select country &quot;UAE 🇦🇪&quot;.</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Displays UAE profile: 0% personal income tax, WPS compliance rule, EOSB gratuity 21d/30d formula, GPSSA national pension rates.</Data></Cell>
