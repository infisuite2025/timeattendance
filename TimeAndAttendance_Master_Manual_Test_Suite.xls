    <Cell ss:StyleID="Cell"><Data ss:Type="String">Manager Approval of Attendance Regularization</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Pending regularization request from direct report</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">1. Log in as MANAGER. 2. Go to /attendance/approvals. 3. Click &quot;Approve&quot;.</Data></Cell>
