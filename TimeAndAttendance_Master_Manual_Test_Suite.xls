    <Cell ss:StyleID="Cell"><Data ss:Type="String">Unit/Functional</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">ADMIN</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Singapore CPF Calculation with Ordinary Wage Cap (S$7,400)</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">On Interactive Calculator tab</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">1. Select Country &quot;Singapore 🇸🇬&quot;. 2. Enter Gross Annual = S$180,000 (S$15k/mo). 3. Toggle IsNational = True. 4. Click &quot;Calculate&quot;.</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Employee CPF contribution capped at 20% of S$7,400 OW ceiling = S$1,480/month. Employer CPF capped at 17% of S$7,400 = S$1,258/month.</Data></Cell>
