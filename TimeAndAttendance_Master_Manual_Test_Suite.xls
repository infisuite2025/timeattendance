    <Cell ss:StyleID="Cell"><Data ss:Type="String">Attendance &amp; Geofencing</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">User Scenario</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">EMPLOYEE</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Submit Manual Attendance Regularization Request</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Employee missed a clock-out yesterday</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">1. Go to /attendance/regularize. 2. Select missing punch date. 3. Enter reason &quot;Client site visit&quot;. 4. Submit.</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Regularization request created with status &quot;PENDING&quot;, queued for Manager approval.</Data></Cell>
