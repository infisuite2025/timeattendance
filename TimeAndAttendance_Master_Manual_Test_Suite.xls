    <Cell ss:StyleID="Cell"><Data ss:Type="String">Functional</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">ADMIN</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Create Shift Definition in Shift Library</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Logged in as ADMIN</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">1. Go to /shifts/library. 2. Click &quot;Add Shift&quot;. 3. Enter Name: &quot;Night Shift B&quot;, Start: 22:00, End: 06:00, Break: 45m. 4. Save.</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Shift template created and available in roster assignment list.</Data></Cell>
    <Cell ss:StyleID="P1"><Data ss:Type="String">P1 - High</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Positive</Data></Cell>
   </Row>
