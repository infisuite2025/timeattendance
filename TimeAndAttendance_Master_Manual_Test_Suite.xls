    <Cell ss:StyleID="Cell"><Data ss:Type="String">Unit/Functional</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">ADMIN</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">UAE Expat Payroll Calculation (0% Tax, 0% Expat SS, EOSB Accrual)</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">On Interactive Calculator tab</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">1. Select Country &quot;UAE 🇦🇪&quot;. 2. Enter Gross Annual = AED 240,000. 3. Toggle IsNational = False. 4. Click &quot;Calculate&quot;.</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Income Tax = 0 (0%), Employee SS = 0, Net Monthly Take-Home = AED 20,000 (100%), EOSB gratuity annual accrual calculated on basic salary.</Data></Cell>
