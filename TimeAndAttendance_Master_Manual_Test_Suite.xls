   <Row ss:Height="40">
    <Cell ss:StyleID="Cell"><Data ss:Type="String">TC-AUTH-001</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Authentication &amp; RBAC</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Unit/Functional</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">ADMIN</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Valid Admin Login with credentials &amp; tenant header injection</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">User is on Login page (/login)</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">1. Select persona &quot;ADMIN (Naresh - ADM-001)&quot;. 2. Enter valid password. 3. Click &quot;Sign In&quot;.</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">System authenticates successfully, stores JWT token and x-tenant-id header (tenant-001), redirects to /dashboard with full Admin sidebar.</Data></Cell>
    <Cell ss:StyleID="P0"><Data ss:Type="String">P0 - Critical</Data></Cell>
    <Cell ss:StyleID="Cell"><Data ss:Type="String">Positive</Data></Cell>
   </Row>
