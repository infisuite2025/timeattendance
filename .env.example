# ==============================================================================
# InfiTimePro - Environment Variables Template
# Copy this file to .env and configure your environment-specific values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SERVER SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8.4)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=infi_timepro_db
DB_USER=infi_timepro_user
DB_PASSWORD=your_secure_db_password_here

# Docker Compose Database Settings
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here
MYSQL_DATABASE=infi_timepro_db
MYSQL_USER=infi_timepro_user
MYSQL_PASSWORD=your_secure_db_password_here

# ------------------------------------------------------------------------------
# 3. REDIS CACHE & BACKGROUND QUEUES
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# 4. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
JWT_SECRET=change_me_to_a_long_random_secure_secret_string_32_chars_min
JWT_EXPIRES_IN=15m

# ------------------------------------------------------------------------------
# 5. FRONTEND WEB CONFIGURATION (Vite)
# ------------------------------------------------------------------------------
VITE_API_URL=http://localhost:4000/api/v1
VITE_APP_TITLE=InfiTimePro - Enterprise Workforce & Attendance Management
VITE_PORT=5173

# ------------------------------------------------------------------------------
# 6. BILLING & PAYMENT GATEWAYS
# ------------------------------------------------------------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder

RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=whsec_placeholder
